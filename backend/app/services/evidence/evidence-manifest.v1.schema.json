{
  "$defs": {
    "CsvCellLocation": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        },
        "kind": {
          "const": "csv_cell",
          "title": "Kind",
          "type": "string"
        },
        "row": {
          "minimum": 1,
          "title": "Row",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "row",
        "column"
      ],
      "title": "CsvCellLocation",
      "type": "object"
    },
    "EngineVersion": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "EngineVersion",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_version": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Asset Version",
          "type": "string"
        },
        "calculation_blocked": {
          "default": false,
          "title": "Calculation Blocked",
          "type": "boolean"
        },
        "calculation_expression": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Expression"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "evidence_id": {
          "pattern": "^e-[a-f0-9]{64}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "source_fact",
            "calculated_fact",
            "ai_inference"
          ],
          "title": "Evidence Type",
          "type": "string"
        },
        "inference_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "discriminator": {
            "mapping": {
              "csv_cell": "#/$defs/CsvCellLocation",
              "excel_cell": "#/$defs/ExcelCellLocation",
              "image_ocr": "#/$defs/ImageOcrLocation",
              "pdf_region": "#/$defs/PdfRegionLocation",
              "text_line": "#/$defs/TextLineLocation",
              "word_paragraph": "#/$defs/WordParagraphLocation"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ExcelCellLocation"
            },
            {
              "$ref": "#/$defs/PdfRegionLocation"
            },
            {
              "$ref": "#/$defs/WordParagraphLocation"
            },
            {
              "$ref": "#/$defs/ImageOcrLocation"
            },
            {
              "$ref": "#/$defs/TextLineLocation"
            },
            {
              "$ref": "#/$defs/CsvCellLocation"
            }
          ],
          "title": "Location"
        },
        "normalized_value": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "ocr_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Confidence"
        },
        "ocr_engine_name": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Engine Name"
        },
        "ocr_engine_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Engine Version"
        },
        "parser_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Parser Name",
          "type": "string"
        },
        "parser_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "raw_value": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Raw Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value_kind": {
          "enum": [
            "narrative",
            "number"
          ],
          "title": "Value Kind",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "asset_id",
        "asset_version",
        "location",
        "raw_value",
        "value_kind",
        "parser_name",
        "parser_version"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "ExcelCellLocation": {
      "additionalProperties": false,
      "properties": {
        "cell": {
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$",
          "title": "Cell",
          "type": "string"
        },
        "kind": {
          "const": "excel_cell",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Sheet",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sheet",
        "cell"
      ],
      "title": "ExcelCellLocation",
      "type": "object"
    },
    "ImageOcrLocation": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "kind": {
          "const": "image_ocr",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "bbox"
      ],
      "title": "ImageOcrLocation",
      "type": "object"
    },
    "ManifestIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^e-[a-f0-9]{64}$",
          "title": "Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "evidence_id"
      ],
      "title": "ManifestIssue",
      "type": "object"
    },
    "PdfRegionLocation": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "kind": {
          "const": "pdf_region",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "maximum": 200,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "page",
        "bbox"
      ],
      "title": "PdfRegionLocation",
      "type": "object"
    },
    "TextLineLocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text_line",
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "line"
      ],
      "title": "TextLineLocation",
      "type": "object"
    },
    "WordParagraphLocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "word_paragraph",
          "title": "Kind",
          "type": "string"
        },
        "paragraph": {
          "minimum": 1,
          "title": "Paragraph",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "paragraph"
      ],
      "title": "WordParagraphLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "format": "uuid",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_version": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Asset Version",
      "type": "string"
    },
    "blockers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ManifestIssue"
      },
      "title": "Blockers",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Evidence",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/EngineVersion"
    },
    "manifest_id": {
      "pattern": "^m-[a-f0-9]{64}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "ocr_engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "evidence-manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_parser": {
      "$ref": "#/$defs/EngineVersion"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ManifestIssue"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "asset_id",
    "asset_version",
    "generated_at",
    "generator",
    "source_parser",
    "evidence"
  ],
  "title": "EvidenceManifest",
  "type": "object"
}
